# ===========================================
#  the-5-agents — Environment Variables
#  העתק קובץ זה ל-.env ומלא את הערכים האמיתיים
#  cp .env.example .env
# ===========================================

# --- Anthropic / Claude (המוח של הצוות) ---
ANTHROPIC_API_KEY=

# --- יצירת תמונות (יובל - מעצב התמונות) ---
# OpenAI Images API (gpt-image-2) — הכלי הפעיל של יובל (סקיל gpt-image-gen)
OPENAI_API_KEY=
# Nano Banana / Gemini (חלופי)
GEMINI_API_KEY=

# --- מחקר ואיסוף מידע (חן - החוקרת) ---
# מנוע חיפוש / מחקר
TAVILY_API_KEY=
PERPLEXITY_API_KEY=

# --- אינטגרציות ואוטומציה ---
# Airtable
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Make.com / Integromat
MAKE_API_KEY=

# Google Sheets
GOOGLE_SHEETS_API_KEY=

# WhatsApp (Green API)
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- הגדרות כלליות ---
NODE_ENV=development
